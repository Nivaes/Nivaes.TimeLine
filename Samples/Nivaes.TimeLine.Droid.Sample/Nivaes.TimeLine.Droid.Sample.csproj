<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>

    <AssemblyName>Nivaes.TimeLine.Droid.Sample</AssemblyName>
    <RootNamespace>Nivaes.TimeLine.Droid.Sample</RootNamespace>
    
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>

    <OptimizationPreference>Speed</OptimizationPreference>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <RunAOTAnalysis>true</RunAOTAnalysis>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.AppCompat" />
    <PackageReference Include="Xamarin.AndroidX.Arch.Core.Runtime" />
    <PackageReference Include="Xamarin.Essentials" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Packets\Nivaes.TimeLine.csproj" />
  </ItemGroup>

</Project>
