<Solution>
  <Configurations>
    <Platform Name="Any CPU" />
    <Platform Name="arm64" />
    <Platform Name="Developer" />
    <Platform Name="x64" />
    <Platform Name="x86" />
  </Configurations>
  <Folder Name="/Samples/">
    <Project Path="Nivaes.TimeLine.Droid.Sample/Nivaes.TimeLine.Droid.Sample.csproj">
      <Deploy />
    </Project>
    <Project Path="Nivaes.TimeLine.iOS.Sample/Nivaes.TimeLine.iOS.Sample.csproj">
      <Platform Solution="Debug|Developer" Project="iPhoneSimulator" />
      <Platform Solution="Release|arm64" Project="iPhoneSimulator" />
      <Platform Solution="Release|Developer" Project="iPhone" />
      <Platform Solution="Release|x64" Project="iPhoneSimulator" />
      <Platform Solution="Release|x86" Project="iPhoneSimulator" />
      <Build Solution="Release|arm64" Project="false" />
      <Build Solution="Release|Developer" Project="false" />
      <Build Solution="Release|x64" Project="false" />
      <Build Solution="Release|x86" Project="false" />
      <Deploy Solution="Debug|arm64" />
      <Deploy Solution="Debug|Developer" />
      <Deploy Solution="Debug|x64" />
      <Deploy Solution="Debug|x86" />
    </Project>
    <Project Path="Nivaes.TimeLine.WinUI.Sample/Nivaes.TimeLine.WinUI.Sample.csproj">
      <Platform Solution="*|Any CPU" Project="x64" />
      <Platform Solution="*|arm64" Project="arm64" />
      <Platform Solution="*|Developer" Project="x64" />
      <Platform Solution="*|x64" Project="x64" />
      <Platform Solution="*|x86" Project="x86" />
      <Deploy />
    </Project>
  </Folder>
  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
    <File Path=".gitattributes" />
    <File Path=".gitignore" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Build.targets" />
    <File Path="Directory.Packages.props" />
    <File Path="global.json" />
    <File Path="LICENSE" />
    <File Path="NuGet.config" />
    <File Path="README.md" />
  </Folder>
  <Folder Name="/Solution Items/.github/" />
  <Folder Name="/Solution Items/.github/workflows/">
    <File Path=".github/workflows/build_release.yaml" />
    <File Path=".github/workflows/ci.yaml" />
    <File Path=".github/workflows/publish_release.yaml" />
  </Folder>
  <Folder Name="/Sources/">
    <Project Path="Nivaes.TimeLine/Nivaes.TimeLine.csproj" />
  </Folder>
</Solution>
